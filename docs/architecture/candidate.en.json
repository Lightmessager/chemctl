  "cards": [
    {
      "dot": "cyan",
      "title": "Calculation and result flow",
      "items": [
        "GUI and CLI reach the local API through a shared HTTP client.",
        "Service coordinates jobs, parsing batches, indexing and queries.",
        "Remote jobs submit PBS scripts over SSH, poll state and sync results via SFTP."
      ]
    },
    {
      "dot": "amber",
      "title": "Data and authentication boundaries",
      "items": [
        "Synced files enter the local cache, then a parsing batch; this branch is omitted here.",
        "Per-job directories and receipts protect submission; uncertain jobs are not retried automatically.",
        "Windows DPAPI can protect SSH private keys; passwords are not stored."
      ]
    },
    {
      "dot": "slate",
      "title": "Scope and scientific limits",
      "items": [
        "Based on the original layout, updated to current code; launcher and key-management internals are omitted.",
        "Mixed basis sets and ECPs follow output evidence, not element-based guesses.",
        "Termination, parsing and scientific convergence are separate; demo jobs perform no computation."
      ]
    }
  ]
