  "cards": [
    {
      "dot": "cyan",
      "title": "计算与结果流程",
      "items": [
        "GUI 与 CLI 通过共享 HTTP 客户端访问本地 API。",
        "Service 协调任务、解析批次、索引与查询。",
        "远程模块用 SSH 提交 PBS 脚本，查询状态并以 SFTP 同步结果。"
      ]
    },
    {
      "dot": "amber",
      "title": "数据与认证边界",
      "items": [
        "同步文件写入本地缓存，再交给解析批次；此支路在总览中省略。",
        "独立任务目录与回执用于控制提交；未知状态不自动重提。",
        "SSH 私钥可由 Windows DPAPI 加密保存；密码不保存。"
      ]
    },
    {
      "dot": "slate",
      "title": "范围与科学限制",
      "items": [
        "沿用原项目结构图布局，更新为当前实现；省略启动器和密钥管理内部细节。",
        "混合基组与 ECP 按输出证据识别，不按元素猜测。",
        "正常终止、解析完成和科学收敛是不同状态；demo 不执行计算。"
      ]
    }
  ]
